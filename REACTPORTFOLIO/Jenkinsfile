pipeline {
    agent any

    environment {
        FRONTEND_DIR = 'REACTPORTFOLIO/reactportfolio'
        BACKEND_DIR = 'REACTPORTFOLIO/EXPRESSJS PORTFOLIO'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Frontend Dependencies') {
                    steps {
                        dir("${env.FRONTEND_DIR}") {
                            echo '📦 Installation des dépendances frontend...'
                            sh 'npm install'
                        }
                    }
                }
                stage('Backend Dependencies') {
                    steps {
                        dir("${env.BACKEND_DIR}") {
                            echo '📦 Installation des dépendances backend...'
                            sh 'npm install'
                        }
                    }
                }
            }
        }

        stage('Tests') {
            steps {
                dir("${env.BACKEND_DIR}") {
                    echo '🧪 Lancement des tests backend...'
                    sh 'npm test'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir("${env.FRONTEND_DIR}") {
                    echo '🔨 Build du frontend React...'
                    sh 'npm run build'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo '🐳 Construction des images Docker...'
                dir('REACTPORTFOLIO') {
                    sh 'docker build -t portfolio-frontend ./reactportfolio'
                    sh 'docker build -t portfolio-backend "./EXPRESSJS PORTFOLIO"'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Déploiement des conteneurs...'
                sh '''
                    docker stop portfolio-frontend portfolio-backend portfolio-mongo || true
                    docker rm portfolio-frontend portfolio-backend portfolio-mongo || true
                    docker network create portfolio-net || true
                    docker run -d --name portfolio-mongo --network portfolio-net mongo:7
                    docker run -d --name portfolio-backend --network portfolio-net -p 5000:5000 -e MONGO_URI=mongodb://portfolio-mongo:27017/portfolio -e USE_MEMORY_DB=false portfolio-backend
                    docker run -d --name portfolio-frontend --network portfolio-net -p 3000:80 portfolio-frontend
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo '✅ Vérification que les services sont opérationnels...'
                sh '''
                    sleep 10
                    curl -f http://localhost:3000 || exit 1
                    curl -f http://localhost:5000/api/projects || exit 1
                '''
                echo '✅ Tous les services sont UP !'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline terminé avec SUCCÈS !'
        }
        failure {
            echo '❌ Pipeline ÉCHOUÉ !'
            sh 'docker stop portfolio-frontend portfolio-backend portfolio-mongo || true'
            sh 'docker rm portfolio-frontend portfolio-backend portfolio-mongo || true'
        }
        always {
            echo '📊 Nettoyage du workspace...'
            cleanWs()
        }
    }
}
